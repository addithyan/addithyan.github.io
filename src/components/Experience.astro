---
type Exp = {
  role: string;
  company: string;
  companyUrl?: string;
  period: string;
  current: boolean;
  bullets: string[];
};

const experiences: Exp[] = [
  {
    role: 'Full Stack Developer',
    company: 'Grey Codes Solutions LLC',
    companyUrl: 'https://www.greycodes.ae/',
    period: 'Feb 2026 – Present',
    current: true,
    bullets: [
      'Developed scalable web applications using Django, React, and REST APIs.',
      'Built backend logic, integrated databases, and created responsive UIs, delivering projects on time.',
      'Optimized features, resolved bugs, and ensured smooth deployment using Git.',
    ],
  },
  {
    role: 'Support Engineer',
    company: 'Grey Codes Solutions LLC',
    companyUrl: 'https://www.greycodes.ae/',
    period: 'Aug 2025 – Feb 2026',
    current: false,
    bullets: [
      'Provided technical support and resolved application issues in real time.',
      'Debugged backend and frontend issues, resolved bugs, and monitored system performance.',
      'Utilized Git for version control and ensured seamless integration.',
    ],
  },
];
---

<style>
  #experience {
    background: #f1faee;
    color: #000;
    padding: 0 0 5rem;
  }
  .exp-title {
    text-align: center;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 800;
    font-size: clamp(2.5rem, 6vw, 5rem);
    padding: 5rem 0 4rem;
    color: #000;
  }

  /* Timeline */
  .timeline-wrap {
    position: relative;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  /* The grey track */
  .tl-track {
    position: absolute;
    left: 50%;
    top: 0; bottom: 0;
    transform: translateX(-50%);
    width: 1px;
    background: #d0d0d0;
    display: block;
  }
  /* The black fill that grows on scroll */
  .tl-fill {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    background: #000;
    height: 0;
    transition: height 0.06s linear;
  }

  .tl-items { display: flex; flex-direction: column; gap: 6rem; }

  /* Each card row */
  .tl-card-row {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    width: 100%;
  }
  /* Odd rows: card on RIGHT */
  .tl-card-row.right { flex-direction: row-reverse; }

  /* Dot on the center line */
  .tl-dot {
    position: absolute;
    left: 50%;
    top: 1.8rem;
    transform: translateX(-50%);
    width: 16px; height: 16px;
    border-radius: 50%;
    background: #000;
    border: 4px solid #f1faee;
    z-index: 10;
    transition: transform 0.3s ease;
  }

  /* Card */
  .tl-card {
    width: 45%;
    background: #fff;
    border-radius: 1.25rem;
    padding: 2rem 2rem 1.75rem;
    box-shadow: 0 4px 24px rgba(0,0,0,0.07);
    border: 1px solid rgba(0,0,0,0.05);
    transition: box-shadow 0.3s ease;
  }
  .tl-card:hover { box-shadow: 0 8px 40px rgba(0,0,0,0.12); }

  .card-header { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem; }
  .card-company { font-family: 'Space Grotesk', sans-serif; font-size: 1.4rem; font-weight: 700; color: #000; }
  .card-role    { font-family: 'Space Grotesk', sans-serif; font-size: 0.9rem; color: #666; font-weight: 500; margin-top: 0.15rem; }
  .card-company a { color: inherit; text-decoration: none; }
  .card-company a:hover { text-decoration: underline; }
  .card-period {
    font-family: 'DM Mono', monospace;
    font-size: 0.72rem;
    font-weight: 500;
    background: #000;
    color: #fff;
    border-radius: 9999px;
    padding: 0.35rem 0.85rem;
    white-space: nowrap;
  }
  .card-period.current { background: #0d6e50; }

  .card-bullets { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .card-bullets li {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.88rem;
    color: #444;
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    line-height: 1.5;
  }
  .card-bullets li::before { content: '•'; color: #000; flex-shrink: 0; margin-top: 0.05rem; }

  /* Responsive */
  @media (max-width: 768px) {
    .tl-track  { left: 1rem; transform: none; }
    .tl-dot    { left: 1rem; transform: translateX(-50%); }
    .tl-card-row,
    .tl-card-row.right { flex-direction: column; padding-left: 2.5rem; }
    .tl-card   { width: 100%; }
  }
  @media (max-width: 480px) {
    .timeline-wrap { padding: 0 1rem; }
    .card-company  { font-size: 1.15rem; }
    .tl-card       { padding: 1.25rem; }
  }
</style>

<section id="experience">
  <h2 class="exp-title reveal">My Journey</h2>

  <div class="timeline-wrap">
    <div class="tl-track" id="tl-track" aria-hidden="true">
      <div class="tl-fill" id="tl-fill"></div>
    </div>

    <div class="tl-items">
      {experiences.map((exp, i) => (
        <div class={`tl-card-row ${i % 2 === 0 ? '' : 'right'}`}>
          <div class="tl-dot" aria-hidden="true"></div>
          <article class="tl-card reveal">
            <div class="card-header">
              <div>
                <p class="card-company">
                  {exp.companyUrl
                    ? <a href={exp.companyUrl} target="_blank" rel="noopener noreferrer">{exp.company}</a>
                    : exp.company}
                </p>
                <p class="card-role">{exp.role}</p>
              </div>
              <span class={`card-period ${exp.current ? 'current' : ''}`}>{exp.period}</span>
            </div>
            <ul class="card-bullets">
              {exp.bullets.map(b => <li>{b}</li>)}
            </ul>
          </article>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Scroll-driven timeline fill
  const track = document.getElementById('tl-track');
  const fill  = document.getElementById('tl-fill');

  function updateFill() {
    if (!track || !fill) return;
    const rect = track.getBoundingClientRect();
    const vh = window.innerHeight;
    const trackH = rect.height;
    // How far we've scrolled into the track
    const scrolled = Math.max(0, Math.min(trackH, vh * 0.5 - rect.top));
    fill.style.height = scrolled + 'px';
  }

  window.addEventListener('scroll', updateFill, { passive: true });
  updateFill();

  // Reveal on scroll
  const revealObs = new IntersectionObserver(
    entries => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); }),
    { threshold: 0.12 }
  );
  document.querySelectorAll('.reveal').forEach(el => revealObs.observe(el));
</script>