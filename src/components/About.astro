        </div>

        <!-- GitHub – outermost ring CCW, 8s -->
        <div class="orbit-item" style="--r:170px; animation: orbitCCW 8s linear infinite; animation-delay:-4s;">
          <svg viewBox="0 0 24 24" width="32" height="32" fill="#efefef"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
        </div>

        <!-- Next.js – between middle & outer CW, 12s -->
        <div class="orbit-item" style="--r:110px; animation: orbitCW 12s linear infinite; animation-delay:-6s;">
          <svg viewBox="0 0 394 80" width="52" height="14" fill="#efefef"><path d="M262 0h68.5v12.7h-27.2v66.6h-13.6V12.7H262V0ZM149 0v12.7H94v20.4h44.3v12.6H94v21h55v12.6H80.5V0h68.7zm34.3 0h-17.8l63.8 79.4h17.9l-32-39.7 32-39.6h-17.9l-23 28.6-23-28.6zm18.3 56.7-9-11-27.1 33.7h17.8l18.3-22.7z"/><path d="M81 79.3 17 0H0v79.3h13.6V17l50.2 62.3H81z"/></svg>
        </div>

        <!-- Firebase – between inner & middle CCW, 9s -->
        <div class="orbit-item" style="--r:60px; animation: orbitCCW 9s linear infinite; animation-delay:-5s;">
          <svg viewBox="0 0 24 24" width="30" height="30"><path fill="#FFA000" d="m14.714 8.669-2.4 2.235-2.228-4.496 1.151-2.585c.291-.516.767-.522 1.058 0l2.419 4.846z"/><path fill="#F57F17" d="m12.314 10.903-8.979 8.351 6.751-12.846 2.228 4.495z"/><path fill="#FFCA28" d="M17.346 5.251c.43-.41.873-.271.985.31l2.334 13.58-7.742 4.648c-.272.152-.992.211-.992.211s-.655-.08-.906-.218l-7.689-4.528 14.01-14.003z"/><path fill="#FFA000" d="m10.086 6.408-6.75 12.846L6.344.477c.113-.582.443-.641.74-.126l3.002 6.057z"/></svg>
        </div>
      </div>
    </div>

    <!-- CTA buttons -->
    <div class="about-ctas">
      <a href="#work" class="cta-btn"><span>Projects</span><div class="cta-fill"></div></a>
      <a href="/adithyan resume.pdf" download class="cta-btn"><span>Resume</span><div class="cta-fill"></div></a>
    </div>
  </div>
  <hr class="divider" />
</section>

<script>
  // Intersection observer for reveals
  const observer = new IntersectionObserver(
    entries => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); }),
    { threshold: 0.15 }
  );
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
</script>
