<style>
  #about {
    background: #0e0e0e;
    width: 100%;
  }
  .about-inner {
    width: min(70%, 900px);
    margin: 0 auto;
    padding: 15vh 0 8vh;
  }

  .about-grid {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 3rem;
    align-items: flex-start;
  }
  .about-text {
    width: min(50%, 420px);
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.4rem, 2.2vw, 2rem);
    line-height: 1.45;
    color: #efefef;
    font-weight: 400;
  }

  /* Orbit container */
  .orbit-wrap {
    position: relative;
    width: min(50%, 360px);
    height: 360px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .orbit-center {
    position: absolute;
    width: 8px; height: 8px;
    border-radius: 50%;
    background: #444;
  }
  .orbit-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.06);
  }
  .orbit-item {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px; height: 48px;
  }
  /* Rotation keyframes */
  @keyframes orbitCW  { from{transform:rotate(0deg)   translateX(var(--r)) rotate(0deg)}   to{transform:rotate(360deg)  translateX(var(--r)) rotate(-360deg)} }
  @keyframes orbitCCW { from{transform:rotate(0deg)   translateX(var(--r)) rotate(0deg)}   to{transform:rotate(-360deg) translateX(var(--r)) rotate(360deg)} }

  .about-ctas {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 4rem;
    padding-bottom: 3rem;
    margin-top: 3rem;
  }
  .cta-btn {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.3rem;
    font-weight: 600;
    border: 1px solid #efefef;
    border-radius: 9999px;
    padding: 0.6rem 2rem;
    color: #efefef;
    background: transparent;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: color 0.35s ease;
  }
  .cta-btn span { position: relative; z-index: 1; }
  .cta-fill {
    position: absolute;
    width: 100%; height: 150%;
    background: #15616D;
    border-radius: 50%;
    bottom: -100%;
    transition: bottom 0.4s cubic-bezier(0.16,1,0.3,1);
  }
  .cta-btn:hover .cta-fill { bottom: -10%; }

  .divider {
    width: 80%;
    margin: 0 auto;
    border: none;
    border-top: 1px solid #222;
  }

  @media (max-width: 900px) {
    .about-inner { width: 90%; padding: 10vh 0 6vh; }
    .about-text  { width: 100%; font-size: 1.3rem; }
    .orbit-wrap  { width: 100%; height: 300px; }
    .about-ctas  { gap: 2rem; }
  }
  @media (max-width: 480px) {
    .about-inner { width: 92%; padding: 8vh 0 4vh; }
    .about-text  { font-size: 1.15rem; }
    .orbit-wrap  { height: 260px; }
    .cta-btn     { font-size: 1rem; padding: 0.5rem 1.5rem; }
  }
</style>

<section id="about">
  <div class="about-inner reveal">
    <div class="about-grid">
      <!-- Text -->
      <p class="about-text">
        Self-taught and motivated full-stack developer. Experienced in building scalable applications in startup environments. Have hands-on experience on modern technologies.
      </p>

      <!-- Orbit icons -->
      <div class="orbit-wrap" aria-hidden="true">
        <!-- Rings -->
        <div class="orbit-ring" style="width:80px;height:80px;"></div>
        <div class="orbit-ring" style="width:180px;height:180px;"></div>
        <div class="orbit-ring" style="width:280px;height:280px;"></div>
        <div class="orbit-ring" style="width:340px;height:340px;"></div>
