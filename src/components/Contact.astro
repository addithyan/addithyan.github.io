<!-- Toast -->
<div id="contact-toast" role="status" aria-live="polite">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="20 6 9 17 4 12"/>
  </svg>
  Message sent! I'll get back to you soon.
</div>

<!-- Error Toast -->
<div id="contact-toast-error" role="alert" aria-live="assertive">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
  </svg>
  <span id="error-toast-msg">Please fill in all required fields correctly.</span>
</div>

<style>
  @keyframes spin { to { transform: rotate(360deg); } }
  .hidden { display: none !important; }
</style>

<script>
  // Load EmailJS
  const ejsScript = document.createElement('script');
  ejsScript.src = 'https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js';
  ejsScript.async = true;
  ejsScript.onload = () => { (window as any).emailjs.init('muuQzhzeKzqoFwGyh'); };
  document.head.appendChild(ejsScript);

  const form       = document.getElementById('contact-form')   as HTMLFormElement;
  const submitBtn  = document.getElementById('submit-btn')     as HTMLButtonElement;
  const btnText    = document.getElementById('btn-text')       as HTMLElement;
  const btnSpin    = document.getElementById('btn-spin')       as HTMLElement;
  const errorEl    = document.getElementById('form-error')     as HTMLElement;
  const toast      = document.getElementById('contact-toast')  as HTMLElement;

  const errorToast    = document.getElementById('contact-toast-error') as HTMLElement;
  const errorToastMsg = document.getElementById('error-toast-msg')     as HTMLElement;
  let toastTimer: ReturnType<typeof setTimeout>;
  let errorToastTimer: ReturnType<typeof setTimeout>;

  function showToast() {
    clearTimeout(toastTimer);
    toast.classList.add('show');
    toastTimer = setTimeout(() => {
      toast.classList.remove('show');
    }, 5000);
  }

  function showErrorToast(msg: string) {
    clearTimeout(errorToastTimer);
    errorToastMsg.textContent = msg;
    errorToast.classList.add('show');
    errorToastTimer = setTimeout(() => {
      errorToast.classList.remove('show');
    }, 10000);
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    // error handled via toast

    const name  = (form.from_name as HTMLInputElement).value.trim();
    const email = (form.from_email as HTMLInputElement).value.trim();
    const msg   = (form.message as HTMLTextAreaElement).value.trim();
    const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);

    if (!name || !emailOk || !msg) {
      showErrorToast('Please fill in all required fields correctly.');
      return;
    }

    submitBtn.disabled = true;
    btnText.classList.add('hidden');
    btnSpin.classList.remove('hidden');

    try {
      await (window as any).emailjs.sendForm('service_vh117rv', 'template_2q6ewjt', form);
      showToast();
      form.reset();
    } catch {
      showErrorToast('Something went wrong. Please email me directly.');
    } finally {
      submitBtn.disabled = false;
      btnText.classList.remove('hidden');
      btnSpin.classList.add('hidden');
    }
  });

  // Reveal observer
  const obs = new IntersectionObserver(
    entries => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); }),
    { threshold: 0.1 }
  );
  document.querySelectorAll('.reveal').forEach(el => obs.observe(el));
</script>