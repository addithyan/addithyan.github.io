<style>
  #contact {
    background: #19191c;
    color: #efefef;
    min-height: 100vh;
    padding: 0 0 4rem;
  }

  .contact-inner {
    width: min(70%, 900px);
    margin: 0 auto;
    padding-top: 12vh;
  }

  /* Big heading */
  .contact-heading {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 800;
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 1;
    color: #efefef;
  }
  .contact-heading-row1 {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-bottom: 0.15rem;
  }
  .contact-avatar {
    width: clamp(4rem, 7vw, 6rem);
    height: clamp(4rem, 7vw, 6rem);
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .contact-avatar-placeholder {
    width: clamp(4rem, 7vw, 6rem);
    height: clamp(4rem, 7vw, 6rem);
    border-radius: 50%;
    background: linear-gradient(135deg,#15616D,#7c3aed);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 800;
    font-size: clamp(1.2rem, 2.5vw, 2rem);
    color: #fff;
  }

  .contact-divider {
    border: none;
    border-top: 1px solid #2e2e32;
    margin: 2.5rem 0;
  }

  /* Contact buttons row */
  .contact-btns {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .contact-btn {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(0.9rem, 1.4vw, 1.25rem);
    font-weight: 500;
    color: #efefef;
    border: 1px solid #5c5c66;
    border-radius: 9999px;
    padding: 0.85rem 1.75rem;
    background: transparent;
    text-decoration: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    transition: color 0.3s ease;
  }
  .contact-btn span { position: relative; z-index: 1; }
  .contact-btn-fill {
    position: absolute;
    width: 100%; height: 150%;
    background: #15616D;
    border-radius: 50%;
    bottom: -100%;
    transition: bottom 0.4s cubic-bezier(0.16,1,0.3,1);
  }
  .contact-btn:hover .contact-btn-fill { bottom: -10%; }

  .social-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .social-icon {
    width: 40px; height: 40px;
    border-radius: 50%;
    background: rgba(255,255,255,0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #efefef;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .social-icon:hover { background: rgba(255,255,255,0.18); }

  /* EmailJS Form */
  .contact-form-wrap {
    margin-top: 3rem;
    padding-top: 2.5rem;
    border-top: 1px solid #2e2e32;
  }
  .form-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 1.1rem;
    color: #efefef;
    margin-bottom: 0.4rem;
  }
  .form-subtitle {
    font-family: 'DM Mono', monospace;
    font-size: 0.72rem;
    color: #666;
    margin-bottom: 1.75rem;
    letter-spacing: 0.08em;
  }
  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .form-group { display: flex; flex-direction: column; gap: 0.4rem; }
  .form-group.full { grid-column: 1 / -1; }
  .form-label {
    font-family: 'DM Mono', monospace;
    font-size: 0.65rem;
    color: #888;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .form-input, .form-textarea {
    background: rgba(255,255,255,0.05);
    border: 1px solid #333;
    border-radius: 10px;
    padding: 0.85rem 1rem;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.9rem;
    color: #efefef;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    width: 100%;
  }
  .form-input::placeholder, .form-textarea::placeholder { color: #555; }
  .form-input:focus, .form-textarea:focus {
    border-color: rgba(21,97,109,0.7);
    box-shadow: 0 0 0 2px rgba(21,97,109,0.2);
  }
  .form-textarea { resize: vertical; min-height: 130px; }

  .submit-btn {
    margin-top: 1.25rem;
    width: 100%;
    padding: 1rem;
    background: #efefef;
    color: #000;
    border: none;
    border-radius: 10px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s, opacity 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
  .submit-btn:hover:not(:disabled) { background: #d0d0d0; }
  .submit-btn:disabled { opacity: 0.6; cursor: not-allowed; }

  .form-msg {
    margin-top: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.85rem;
    text-align: center;
    display: none;
  }
  .form-msg.error { background: rgba(248,113,113,0.1); color: #f87171; border: 1px solid rgba(248,113,113,0.2); }

  /* Toast */
  #contact-toast-error {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%) translateY(120%);
    background: rgba(248,113,113,0.12);
    color: #f87171;
    border: 1px solid rgba(248,113,113,0.25);
    border-radius: 10px;
    padding: 0.85rem 1.5rem;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    z-index: 9999;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    transition: transform 0.4s cubic-bezier(0.16,1,0.3,1), opacity 0.4s ease;
    opacity: 0;
    pointer-events: none;
  }
  #contact-toast-error.show {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
    pointer-events: auto;
  }
  #contact-toast-error svg { flex-shrink: 0; }

  #contact-toast {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%) translateY(120%);
    background: rgba(74,222,128,0.12);
    color: #4ade80;
    border: 1px solid rgba(74,222,128,0.25);
    border-radius: 10px;
    padding: 0.85rem 1.5rem;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    z-index: 9999;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    transition: transform 0.4s cubic-bezier(0.16,1,0.3,1), opacity 0.4s ease;
    opacity: 0;
    pointer-events: none;
  }
  #contact-toast.show {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
    pointer-events: auto;
  }
  #contact-toast svg { flex-shrink: 0; }

  @media (max-width: 900px) {
    .contact-inner { width: 90%; }
  }
  @media (max-width: 600px) {
    .contact-inner { width: 92%; padding-top: 8vh; }
    .contact-heading { font-size: clamp(2.2rem, 10vw, 4rem); }
    .form-grid { grid-template-columns: 1fr; }
    .contact-btns { gap: 0.75rem; }
    .contact-btn { font-size: 0.85rem; padding: 0.7rem 1.25rem; }
    #contact-toast { width: calc(100vw - 3rem); }
  }
</style>

<section id="contact">
  <div class="contact-inner reveal">
    <!-- Heading -->
    <div class="contact-heading">
      <div class="contact-heading-row1">
        <div class="contact-avatar-placeholder">AB</div>
        <span>Let's</span>
      </div>
      <div>Connect</div>
    </div>

    <hr class="contact-divider" />

    <!-- Info buttons -->
    <div class="contact-btns">
      <a href="mailto:adithyanb12b@gmail.com" class="contact-btn">
        <span>adithyanb12b@gmail.com</span>
        <div class="contact-btn-fill"></div>
      </a>
      <a href="tel:+919895424559" class="contact-btn">
        <span>+91 98954 24559</span>
        <div class="contact-btn-fill"></div>
      </a>
      <div class="social-row">
        <a href="https://github.com/addithyan" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="GitHub">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
        </a>
        <a href="https://linkedin.com/in/adithyan-b-637a66229" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="LinkedIn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
      </div>
    </div>

    <!-- Contact form -->
    <div class="contact-form-wrap">
      <p class="form-title">Send me a message</p>
      <p class="form-subtitle">I'll get back to you within 24 hours.</p>

      <form id="contact-form" novalidate>
        <div class="form-grid">
          <div class="form-group">
            <label class="form-label" for="from_name">Name *</label>
            <input class="form-input" type="text" id="from_name" name="from_name" placeholder="Your name" required />
