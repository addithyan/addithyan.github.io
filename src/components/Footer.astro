---
const year = new Date().getFullYear();
---

<style>
  footer {
    background: #19191c;
    border-top: 1px solid #2e2e32;
    padding: 2rem 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .footer-logo {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 0.05em;
    color: #efefef;
    text-transform: uppercase;
    text-decoration: none;
  }
  .footer-copy {
    font-family: 'DM Mono', monospace;
    font-size: 0.65rem;
    color: #555;
    letter-spacing: 0.08em;
  }
  .footer-links {
    display: flex;
    gap: 2rem;
  }
  .footer-links a {
    font-family: 'DM Mono', monospace;
    font-size: 0.65rem;
    color: #555;
    text-decoration: none;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color 0.2s;
  }
  .footer-links a:hover { color: #efefef; }

  @media (max-width: 600px) {
    footer { flex-direction: column; align-items: flex-start; padding: 1.5rem 1.5rem; }
    .footer-links { gap: 1.5rem; flex-wrap: wrap; }
  }
</style>

<footer>
  <a href="#" class="footer-logo">AB</a>
  <p class="footer-copy">© {year} Adithyan B · Built with Astro</p>
  <nav class="footer-links">
    <a href="#about">About</a>
    <a href="#experience">Experience</a>
    <a href="#skills">Skills</a>
    <a href="#projects">Projects</a>
    <a href="#contact">Contact</a>
  </nav>
</footer>