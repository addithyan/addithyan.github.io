---
type Project = {
  title: string;
  year: string;
  tag: string;
  description: string;
  tech: string[];
  github?: string;
  link?: string;
  coverBg: string;
};

const projects: Project[] = [
  {
    title: 'Journey Sync',
    year: '2024',
    tag: 'Transport',
    description: 'Multi-route bus booking system with real-time seat availability, route management, and a seamless booking experience for passengers.',
    tech: ['Express.js', 'MongoDB', 'HTML', 'CSS'],
    github: 'https://github.com/addithyan/busbooking',
    coverBg: 'linear-gradient(135deg,#0f2027,#203a43,#2c5364)',
  },
  {
    title: 'DataHive',
    year: '2025',
    tag: 'AI / ML',
    description: 'LLM-powered educational management platform with context-aware RAG architecture for efficient organisation, retrieval, and interaction with college data.',
    tech: ['React', 'FastAPI', 'LLaMA 3.1', 'FAISS', 'Firebase'],
    github: 'https://github.com/addithyan/locally-running-llm-powered-lms-DataHive',
    coverBg: 'linear-gradient(135deg,#0d0d1a,#1a0533,#0d1a33)',
  },
  {
    title: 'Medi Validator',
    year: '2025',
    tag: 'Healthcare',
    description: 'Full-stack medical claim validation platform with RBAC, bulk processing, and background workflows for healthcare professionals.',
    tech: ['Django', 'React', 'MySQL', 'Celery', 'Redis'],
    link: 'https://medivalidator.in/login',
    coverBg: 'linear-gradient(135deg,#0a1628,#0d2137,#0a2818)',
  },
  {
    title: 'Eligibility System',
    year: '2025',
    tag: 'Insurance',
    description: 'Automated insurance eligibility verification system validating patient data across multiple portals with fast caching and optimised data processing.',
    tech: ['Django', 'React', 'MySQL', 'Redis'],
    link: 'https://eligibility.medivalidator.in/login',
    coverBg: 'linear-gradient(135deg,#0f1923,#1a2535,#0f2030)',
  },
  {
    title: 'CoolFixz Solutions',
    year: '2025',
    tag: 'Business',
    description: 'Suite of business tools including a billing system, automated tag generator, and landing pages for Solar and HVAC divisions.',
    tech: ['React', 'Django', 'Tailwind CSS'],
    link: 'https://solar.coolfixz.com',
    coverBg: 'linear-gradient(135deg,#1a1200,#2a1f00,#1a2200)',
  },
];
---

<style>
  #projects {
    background: #f1faee;
    color: #000;
    padding: 0 0 4rem;
  }

  .proj-header {
    max-width: 1100px;
    margin: 0 auto;
    padding: 4rem 2rem 1rem;
  }
  .proj-heading {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 800;
    font-size: clamp(2rem, 4vw, 3.5rem);
    color: #000;
    margin-bottom: 0.25rem;
  }
  .proj-sub {
    font-family: 'DM Mono', monospace;
    font-size: 0.75rem;
    color: #888;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  /* List */
  .proj-list {
    max-width: 1100px;
    margin: 2rem auto 0;
    padding: 0 2rem;
  }

  .proj-row {
    border-top: 1px solid #ccc;
    padding: 1.75rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    text-decoration: none;
    color: #000;
    cursor: pointer;
    transition: opacity 0.25s ease;
    position: relative;
  }
  .proj-row:last-child { border-bottom: 1px solid #ccc; }
  /* Dim other rows on sibling hover */
  .proj-list:has(.proj-row:hover) .proj-row:not(:hover) { opacity: 0.35; }

  .proj-row-left { display: flex; align-items: center; gap: 1.5rem; flex: 1; min-width: 0; }
  .proj-row-num {
    font-family: 'DM Mono', monospace;
    font-size: 0.75rem;
    color: #999;
    flex-shrink: 0;
    width: 1.8rem;
  }
  .proj-row-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.3rem, 3vw, 2rem);
    font-weight: 700;
    color: #000;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .proj-row-tag {
    font-family: 'DM Mono', monospace;
    font-size: 0.7rem;
    color: #666;
    margin-left: auto;
    flex-shrink: 0;
    display: none;
  }
  @media (min-width: 640px) { .proj-row-tag { display: block; } }

  .proj-row-links { display: flex; gap: 0.5rem; flex-shrink: 0; }
  .proj-link-icon {
    width: 36px; height: 36px;
    border: 1px solid #ccc;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    color: #666;
    transition: background 0.2s, color 0.2s;
    text-decoration: none;
    background: #fff;
  }
  .proj-link-icon:hover { background: #000; color: #fff; }

  /* Floating preview card */
  #proj-preview {
    position: fixed;
    pointer-events: none;
    z-index: 200;
    border-radius: 14px;
    overflow: hidden;
    width: 320px;
    background: #fff;
    box-shadow: 0 20px 60px rgba(0,0,0,0.18);
    opacity: 0;
    transform: scale(0.85) translateY(10px);
    transition: opacity 0.25s ease, transform 0.25s cubic-bezier(0.16,1,0.3,1);
    will-change: transform;
  }
  #proj-preview.show {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
  .preview-cover {
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.5rem;
    font-weight: 800;
    color: rgba(255,255,255,0.7);
  }
  .preview-body { padding: 1rem 1.25rem 1.25rem; }
  .preview-tag {
    font-family: 'DM Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #999;
    margin-bottom: 0.4rem;
  }
  .preview-name {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    color: #000;
    margin-bottom: 0.5rem;
  }
  .preview-desc {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.8rem;
    color: #555;
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }
  .preview-techs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .preview-tech {
    font-family: 'DM Mono', monospace;
    font-size: 0.65rem;
    color: #666;
    border: 1px solid #ddd;
    border-radius: 4px;
    padding: 0.2rem 0.5rem;
    background: #f9f9f9;
  }

  @media (max-width: 600px) {
    .proj-list { padding: 0 1rem; }
    .proj-header { padding: 3rem 1rem 1rem; }
    #proj-preview { display: none; }
  }
</style>

<!-- Floating preview -->
<div id="proj-preview" aria-hidden="true">
  <div class="preview-cover" id="preview-cover"></div>
  <div class="preview-body">
    <p class="preview-tag" id="preview-tag"></p>
    <p class="preview-name" id="preview-name"></p>
    <p class="preview-desc" id="preview-desc"></p>
    <div class="preview-techs" id="preview-techs"></div>
  </div>
</div>

<section id="projects">
  <div class="proj-header reveal">
    <p class="proj-sub">Selected Work</p>
    <h2 class="proj-heading">Things I've Built</h2>
  </div>

  <div class="proj-list" id="proj-list">
    {projects.map((p, i) => (
      <div
        class="proj-row"
        data-title={p.title}
        data-tag={p.tag}
        data-desc={p.description}
        data-tech={p.tech.join(',')}
        data-bg={p.coverBg}
        data-github={p.github ?? ''}
        data-link={p.link ?? ''}
        role="article"
      >
        <div class="proj-row-left">
          <span class="proj-row-num">0{i + 1}</span>
          <span class="proj-row-title">{p.title}</span>
        </div>
        <span class="proj-row-tag">{p.tag}</span>
        <div class="proj-row-links">
          {p.github && (
            <a href={p.github} target="_blank" rel="noopener noreferrer" class="proj-link-icon" aria-label={`GitHub: ${p.title}`} onclick="event.stopPropagation()">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
            </a>
          )}
          {p.link && (
            <a href={p.link} target="_blank" rel="noopener noreferrer" class="proj-link-icon" aria-label={`Live site: ${p.title}`} onclick="event.stopPropagation()">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          )}
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  const preview   = document.getElementById('proj-preview')!;
  const pCover    = document.getElementById('preview-cover')!;
  const pTag      = document.getElementById('preview-tag')!;
  const pName     = document.getElementById('preview-name')!;
  const pDesc     = document.getElementById('preview-desc')!;
  const pTechs    = document.getElementById('preview-techs')!;

  let mx = 0, my = 0, raf = 0;
  let active = false;

  document.addEventListener('mousemove', e => {
    mx = e.clientX; my = e.clientY;
    if (active) positionPreview();
  });

  function positionPreview() {
    const pw = 320, ph = 300;
    const vw = window.innerWidth, vh = window.innerHeight;
    let x = mx + 20, y = my - ph / 2;
    if (x + pw > vw - 10) x = mx - pw - 20;
    if (y < 10) y = 10;
    if (y + ph > vh - 10) y = vh - ph - 10;
    preview.style.left = x + 'px';
    preview.style.top  = y + 'px';
  }

  document.querySelectorAll<HTMLElement>('.proj-row').forEach(row => {
    row.addEventListener('mouseenter', () => {
      const title  = row.dataset.title  ?? '';
      const tag    = row.dataset.tag    ?? '';
      const desc   = row.dataset.desc   ?? '';
      const techsStr = row.dataset.tech ?? '';
      const bg     = row.dataset.bg     ?? '#111';

      pCover.style.background = bg;
      pCover.textContent = title;
      pTag.textContent   = tag;
      pName.textContent  = title;
      pDesc.textContent  = desc;
      pTechs.innerHTML   = techsStr.split(',').map(t =>
        `<span class="preview-tech">${t.trim()}</span>`
      ).join('');

      positionPreview();
      active = true;
      preview.classList.add('show');
    });

    row.addEventListener('mouseleave', () => {
      active = false;
      preview.classList.remove('show');
    });
  });

  // Reveal on scroll
  const obs = new IntersectionObserver(
    entries => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); }),
    { threshold: 0.1 }
  );
  document.querySelectorAll('.reveal').forEach(el => obs.observe(el));
</script>