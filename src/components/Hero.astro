<style>
  /* ── Loading overlay ── */
  #loader {
    position: fixed; inset: 0; z-index: 9999;
    background: #0e0e0e;
    display: flex; align-items: center; justify-content: center;
    pointer-events: all;
    transition: opacity 0.6s ease 0.1s, visibility 0.6s ease 0.1s;
  }
  #loader.done { opacity: 0; visibility: hidden; pointer-events: none; }

  #loader-word {
    overflow: hidden;
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(10vw, 14vw, 12vw);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: #efefef;
  }
  #loader-word span {
    display: block;
    transform: translateY(110%);
    animation: revealUp 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0.15s forwards;
  }

  @keyframes revealUp {
    to { transform: translateY(0); }
  }

  /* ── Hero section ── */
  #hero {
    position: relative;
    min-height: 100vh;
    background: #0e0e0e;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  #hero.visible { opacity: 1; }

  /* Top bar */
  .hero-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 2.5rem 2.5rem 0;
    position: relative;
    z-index: 10;
  }
  .hero-logo {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: 0.05em;
    color: #efefef;
    text-transform: uppercase;
    text-decoration: none;
  }
  .hero-nav {
    display: flex;
    gap: 3rem;
    list-style: none;
    margin: 0; padding: 0;
  }
  .hero-nav a {
    font-family: 'DM Mono', monospace;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #888;
    text-decoration: none;
    transition: color 0.2s;
  }
  .hero-nav a:hover { color: #efefef; }

  /* Role label */
  .hero-role {
    font-family: 'DM Mono', monospace;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #888;
    padding: 0 2.5rem;
    position: relative;
    z-index: 10;
    margin-top: 1.5rem;
  }

  /* Big name */
  .hero-name-wrap {
    position: relative;
    z-index: 10;
    padding: 0 1.5rem;
    margin-top: -0.5rem;
    overflow: hidden;
  }
  .hero-name {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 800;
    font-size: clamp(14vw, 17vw, 17vw);
    line-height: 0.85;
    letter-spacing: -0.03em;
    color: #efefef;
    display: block;
    transform: translateY(50px);
    opacity: 0;
    animation: fadeSlideUp 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.9s forwards;
  }
  @keyframes fadeSlideUp {
    to { transform: translateY(0); opacity: 1; }
  }

  /* Scroll + status bottom strip */
  .hero-bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 1.5rem 2.5rem 2.5rem;
    position: relative;
    z-index: 10;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .hero-desc {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.75rem;
    color: #888;
    max-width: 36%;
    line-height: 1.6;
    min-width: 220px;
    animation: fadeIn 1s ease 1.2s both;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .hero-badges {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
    animation: fadeIn 1s ease 1.3s both;
  }
  .badge {
    border: 1px solid #333;
    border-radius: 9999px;
    padding: 0.5rem 1.2rem;
    font-family: 'DM Mono', monospace;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .badge.green { color: #4ade80; border-color: #1a3a28; }
  .badge.gray  { color: #888; }
  .dot-green {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #4ade80;
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.4; }
  }

  /* Scroll indicator (right side) */
  .scroll-side {
    position: absolute;
    right: 2rem;
    top: 50%;
    transform: translateY(-50%) rotate(90deg);
    transform-origin: center;
    font-family: 'DM Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #888;
    animation: fadeIn 1s ease 1.4s both;
  }

  @media (max-width: 768px) {
    .hero-top { padding: 1.2rem 1.5rem 0; }
    .hero-nav { display: none; }
    .hero-role { padding: 0 1.5rem; margin-top: 1.2rem; }
    .hero-name-wrap { padding: 0 1rem; }
    .hero-name { font-size: clamp(17vw, 22vw, 22vw); }
    .hero-bottom { padding: 1rem 1.5rem 1.5rem; }
    .hero-desc { max-width: 100%; min-width: unset; font-size: 0.7rem; }
    .hero-badges { align-items: flex-start; }
    .scroll-side { display: none; }
  }
</style>

<!-- Loading screen -->
<div id="loader">
  <div id="loader-word"><span>Adithyan B</span></div>
</div>

<!-- Hero -->
<section id="hero" aria-label="Introduction">
  <!-- Top bar (duplicated for hero layout, navbar handles actual nav) -->
  <div class="hero-top">
    <a href="#" class="hero-logo">AB</a>
    <ul class="hero-nav">
      <li><a href="#work">Work</a></li>
      <li><a href="#about">About</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
  </div>

  <p class="hero-role">Full Stack Developer</p>

  <div class="hero-name-wrap">
    <span class="hero-name">Adithyan</span>
    <span class="hero-name" style="animation-delay: 1.0s;">B</span>
  </div>

  <div class="hero-bottom">
    <p class="hero-desc">
      B.Tech CSE from SJCET Pala. Experienced in building scalable full-stack applications including medical platforms, AI-powered tools, and business systems.
    </p>
    <div class="hero-badges">
      <div class="badge green"><span class="dot-green"></span>Available for work</div>
      <div class="badge gray">Kottayam, Kerala</div>
    </div>
  </div>

  <div class="scroll-side" aria-hidden="true">Scroll</div>
</section>

<script>
  // Dismiss loader after animation, reveal hero
  window.addEventListener('DOMContentLoaded', () => {
    const loader = document.getElementById('loader');
    const hero   = document.getElementById('hero');
    setTimeout(() => {
      loader?.classList.add('done');
      hero?.classList.add('visible');
    }, 1100);
  });
</script>
